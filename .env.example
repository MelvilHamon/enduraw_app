# Environment: dev | prod
ENV=dev

# Database (SQLite by default). In Docker the path resolves to the ./data volume.
DATABASE_URL=sqlite:///./data/enduraw.db

# JWT — CHANGE THIS IN PRODUCTION (app refuses to boot in prod with the dev value)
JWT_SECRET=changeme-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Engine integration (CoachAgent). mock = standalone (reads local snapshots);
# live = call the CoachAgent REST API (requires base URL + API key below).
ENGINE_MODE=mock
COACHAGENT_BASE_URL=
COACHAGENT_API_KEY=
COACHAGENT_TIMEOUT_S=10.0
COACHAGENT_MAX_RETRIES=3
# Per-user JSON snapshots for the mock engine (written by scripts/seed.py).
MOCK_ENGINE_DIR=./data/mock_engine

# Seeding (synthetic data generator, later steps)
SEED_ON_START=false

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
